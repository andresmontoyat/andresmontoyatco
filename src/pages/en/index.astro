---
// src/pages/en/index.astro — thin locale entry, proves the /en route tree
// resolves through BaseLayout (ROUTE-01). Mounts the Nav island (Phase 22).
// Content-section components (Hero/About/etc.) migrate in Phase 23+.
import BaseLayout from '../../layouts/BaseLayout.astro'
import Nav from '../../components/react/Nav.jsx'
import SectionPager from '../../components/react/SectionPager.jsx'
import Hero from '../../components/astro/Hero.astro'
import About from '../../components/astro/About.astro'
import Skill from '../../components/astro/Skill.astro'
import Experience from '../../components/react/Experience.jsx'
import Projects from '../../components/astro/Projects.astro'
import Claude from '../../components/astro/Claude.astro'
import Contact from '../../components/astro/Contact.astro'
import Footer from '../../components/astro/Footer.astro'
import { getRelativeLocaleUrl } from 'astro:i18n'
import translations from '../../i18n/translations.js'

const locale = Astro.currentLocale ?? 'en'
const path = Astro.url.pathname.replace(/^\/(en|es)/, '') || '/'
const hrefEn = getRelativeLocaleUrl('en', path)
const hrefEs = getRelativeLocaleUrl('es', path)
const hrefGame = getRelativeLocaleUrl(locale, '/game')
const t = translations[locale].entry
---
<BaseLayout>
  <!-- Entry splash — "start screen" first-load choice: Play the career game or
       View the portfolio. Server-rendered HTML only (no React island), hidden
       by default via inline style so it never lays out or paints unless JS
       un-hides it — can't hurt LCP. The is:inline script right after this
       markup runs synchronously before the browser paints it (mirrors
       BaseLayout's pre-paint theme-flip script): it checks sessionStorage
       first and, if the visitor already chose this session
       (cam-entry-choice), simply returns — the div stays display:none, no
       flash. -->
  <div
    id="entry-splash"
    role="dialog"
    aria-modal="true"
    aria-labelledby="entry-splash-title"
    style="display:none"
    class="fixed inset-0 z-[200] flex items-center justify-center p-6 bg-ink-950/90 backdrop-blur-md motion-safe:animate-fade-in"
  >
    <div class="w-full max-w-md rounded-2xl border border-ink-500 bg-surface p-8 text-center shadow-brand-lg">
      <!-- avatar-preview.png is a self-contained 64x64 render of the dressed hero (base + Iron
           plate legs/chest/helm), baked by scripts/pack-atlas.mjs so it ships in public/game/
           (the raw pack is gitignored). Regenerate with `npm run assets:pack`. -->
      <div class="mx-auto mb-4 h-16 w-16 overflow-hidden rounded-lg border border-ink-500 bg-ink-900" aria-hidden="true">
        <img
          src="/game/avatar-preview.png"
          alt=""
          loading="lazy"
          decoding="async"
          class="h-16 w-16 max-w-none [image-rendering:pixelated]"
        />
      </div>
      <div class="font-pixel text-[10px] uppercase tracking-[1px] text-accent flex items-center justify-center gap-3 mb-4">
        <span class="block w-8 h-0.5 bg-accent" /> {t.eyebrow} <span class="block w-8 h-0.5 bg-accent" />
      </div>
      <h2 id="entry-splash-title" class="font-pixel text-lg sm:text-xl font-extrabold text-text mb-3 leading-tight">
        {t.title}
      </h2>
      <p class="text-muted text-sm mb-8">{t.hook}</p>
      <div class="flex flex-col sm:flex-row gap-3 justify-center">
        <a
          id="entry-splash-play"
          href={hrefGame}
          class="font-pixel inline-flex items-center justify-center gap-2 rounded-xl bg-brand px-6 py-3 text-[11px] text-ink-950 font-bold tracking-wide shadow-brand hover:bg-brand-light focus:outline-none focus-visible:ring-2 focus-visible:ring-brand-light transition-colors"
        >
          ▶ {t.play}
        </a>
        <button
          type="button"
          id="entry-splash-view"
          class="inline-flex items-center justify-center gap-2 rounded-xl border border-ink-500 px-6 py-3 text-sm text-text hover:border-brand/60 hover:text-brand focus:outline-none focus-visible:ring-2 focus-visible:ring-brand transition-colors"
        >
          {t.view} →
        </button>
      </div>
    </div>
  </div>
  <script is:inline>
    // Entry splash controller — remembers the choice for the session
    // (sessionStorage key cam-entry-choice) so it shows at most once per tab
    // session. Runs before paint (is:inline, placed right after the markup)
    // so an already-chosen session never flashes the overlay.
    (function () {
      var KEY = 'cam-entry-choice'
      var overlay = document.getElementById('entry-splash')
      if (!overlay) return

      var alreadyChosen = false
      try {
        alreadyChosen = !!sessionStorage.getItem(KEY)
      } catch (e) {
        // sessionStorage blocked (private mode, etc) — fall through, show it
      }
      if (alreadyChosen) return

      var playBtn = document.getElementById('entry-splash-play')
      var viewBtn = document.getElementById('entry-splash-view')
      var focusable = [playBtn, viewBtn].filter(Boolean)

      function remember() {
        try {
          sessionStorage.setItem(KEY, '1')
        } catch (e) {
          // sessionStorage blocked — choice just won't persist across reloads
        }
      }

      function dismiss() {
        remember()
        overlay.style.display = 'none'
        document.body.style.overflow = ''
        document.removeEventListener('keydown', onKeydown)
      }

      function onKeydown(e) {
        if (e.key === 'Escape') {
          dismiss()
          return
        }
        if (e.key !== 'Tab' || focusable.length === 0) return
        e.preventDefault()
        var idx = focusable.indexOf(document.activeElement)
        var next = e.shiftKey ? idx - 1 : idx + 1
        if (next < 0) next = focusable.length - 1
        if (next >= focusable.length) next = 0
        focusable[next].focus()
      }

      overlay.style.display = ''
      document.body.style.overflow = 'hidden'
      document.addEventListener('keydown', onKeydown)
      overlay.addEventListener('click', function (e) {
        if (e.target === overlay) dismiss()
      })
      if (viewBtn) viewBtn.addEventListener('click', dismiss)
      if (playBtn) playBtn.addEventListener('click', remember)
      if (playBtn) playBtn.focus()
    })()
  </script>
  <Nav client:load locale={locale} hrefEn={hrefEn} hrefEs={hrefEs} hrefGame={hrefGame} />
  <SectionPager client:visible locale={locale} />
  <main>
    <Hero locale={locale} />
    <About locale={locale} />
    <Skill locale={locale} />
    <Experience client:visible locale={locale} />
    <Projects locale={locale} />
    <Claude locale={locale} />
    <Contact locale={locale} />
  </main>
  <Footer locale={locale} />
</BaseLayout>
